<Window x:Class="QuizConfiguratorV2.Dialogs.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizConfiguratorV2.Dialogs"
        mc:Ignorable="d"
        Title="PackOptions"
        Height="370"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Pack Options"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Pack Name:"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PackNameTextBox"
                     Height="30"
                     Margin="0,0,0,15"/>


            <TextBlock Text="Difficulty:"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="DifficultyComboBox"
                      Height="30"
                      SelectedIndex="1"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Easy"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Hard"/>
            </ComboBox>

            <TextBlock Text="Time Limit (seconds):"
                           Margin="0,0,0,5"/>

            <TextBox x:Name="TimeLimitTextBox"
                         Text="30"
                         Height="30"
                         Margin="0,0,0,20"/>



            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="80"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>    


                <Button Content="Save"
                        Width="80"
                        Height="30"
                        Click="SaveButton_Click"/>
            </StackPanel>


        </StackPanel>
    </Grid>
</Window>
