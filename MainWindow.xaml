<Window x:Class="QuizConfiguratorV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizConfiguratorV2"
        xmlns:views="clr-namespace:QuizConfiguratorV2.Views"
        mc:Ignorable="d"
        Title="Quiz Configurator" Height="650" Width="1000">
    <Window.InputBindings>
        <KeyBinding Key="N" 
                    Modifiers="Control"
                    Command="{Binding Path=DataContext.NewPackCommand, ElementName=ConfigurationViewControl}"/>
        <KeyBinding Key="A" Modifiers="Control"
                    Command="{Binding DataContext.AddQuestionCommand, ElementName=ConfigurationViewControl}"/>
        <KeyBinding Key="Delete" Modifiers="Control"
                    Command="{Binding DataContext.DeleteQuestionCommand, ElementName=ConfigurationViewControl}"/>
        <KeyBinding Key="O" Modifiers="Control"
                    Command="{Binding DataContext.PackOptionsCommand, ElementName=ConfigurationViewControl}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:MenuView Grid.Row="0"
                        DataContext="{Binding DataContext, ElementName=ConfigurationViewControl}"/>

        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem Header="Configuration">
                <views:ConfigurationView
                x:Name="ConfigurationViewControl"/>
            </TabItem>

            <TabItem Header="Play Quiz">
                <views:PlayerView 
                    x:Name="PlayerViewControl"/>

            </TabItem>
        </TabControl>
        
        
    </Grid>
</Window>
