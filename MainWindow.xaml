<Window x:Class="QuizConfiguratorV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizConfiguratorV2"
        xmlns:views="clr-namespace:QuizConfiguratorV2.Views"
        mc:Ignorable="d"
        Title="Quiz Configurator" Height="650" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:MenuView Grid.Row="0"/>
        <views:ConfigurationView Grid.Row="1"/>
    </Grid>
</Window>
