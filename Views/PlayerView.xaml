<UserControl x:Class="QuizConfiguratorV2.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizConfiguratorV2.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Play Quiz"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Select Question Pack:"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="PackComboBox"
                      Height="35"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,15"/>

            <Button x:Name="StartQuizButton"
                    Content="Start Quiz"
                    Height="35"
                    Width="130"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left"
                    Click="StartQuiz_Click"/>


            <TextBlock x:Name="QuestionNumberText"
                       FontSize="14"
                       Margin="0,0,0,10"/>
            
            <TextBlock x:Name="QuestionText"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <StackPanel x:Name="AnswerPanel"
                        Margin="0,0,0,20">
                <RadioButton x:Name="Answer1Radio"
                                GroupName="QuizAnswers"
                                Margin="0,0,0,10"/>
                <RadioButton x:Name="Answer2Radio"
                                GroupName="QuizAnswers"
                                Margin="0,0,0,10"/>
                <RadioButton x:Name="Answer3Radio"
                                GroupName="QuizAnswers"
                                Margin="0,0,0,10"/>
                <RadioButton x:Name="Answer4Radio"
                                GroupName="QuizAnswers"
                                Margin="0,0,0,10"/>

            </StackPanel>

            <Button x:Name="NextQuestionButton" 
                    Content="Next Question"
                    Height="35"
                    Width="150"
                    HorizontalAlignment="Left"
                    Click="NextQuestionButton_Click"/>


            <TextBlock x:Name="ResultText"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,20,0,0"/>

        </StackPanel>
    </Grid>
</UserControl>
