<UserControl x:Class="QuizConfiguratorV2.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizConfiguratorV2.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">

            <TextBlock Text="Question Packs"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

            <ListBox Height="300"
                     ItemsSource="{Binding QuestionPacks}"
                     SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                     DisplayMemberPath="Name"/>


            <StackPanel Orientation="Horizontal" 
                    Margin="0,10,0,0">

                <Button x:Name="NewPackButton"
                    Content="New Pack"
                    Width="100"
                    Margin="0,0,10,0"
                    Command="{Binding NewPackCommand}"/>


                <Button Content="Delete"
                    Width="100"
                    Command="{Binding DeletePackCommand}"/>


            </StackPanel>

        </StackPanel>
        <StackPanel Grid.Column="1">


            <TextBlock Text="Question Editor"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
            
            <TextBlock Text="Question"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            
            <ListBox Height="100"
                     Margin="0,0,0,15"
                     ItemsSource="{Binding CurrentQuestions}"
                     SelectedItem="{Binding SelectedQuestion, Mode=TwoWay}"
                     DisplayMemberPath="Text"/>


            <TextBlock Text="Question:"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <TextBox Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding SelectedQuestion.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Answer Options"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>

            <TextBlock Text="Select the correct answer:"
                       Margin="0,0,0,10"/>

            <StackPanel>
                <RadioButton GroupName="CorrectAnswer"
                             Content="Answer 1"
                             Margin="0,0,0,5"/>
                <TextBox Height="30" Margin="0,0,0,10"
                         Text="{Binding SelectedQuestion.Answer1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <RadioButton GroupName="CorrectAnswer"
                             Content="Answer 2"
                             Margin="0,0,0,5"
                             IsChecked="{Binding IsAnswer1Correct, Mode=TwoWay}"/>
                <TextBox Height="30" Margin="0,0,0,10"
                         Text="{Binding SelectedQuestion.Answer2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <RadioButton GroupName="CorrectAnswer"
                             Content="Answer 3"
                             Margin="0,0,0,5"
                             IsChecked="{Binding IsAnswer3Correct, Mode=TwoWay}"/>
                <TextBox Height="30" Margin="0,0,0,10"
                         Text="{Binding SelectedQuestion.Answer3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <RadioButton GroupName="CorrectAnswer"
                             Content="Answer 4"
                             Margin="0,0,0,5"
                             IsChecked="{Binding IsAnswer4Correct, Mode=TwoWay}"/>
                <TextBox Height="30"
                         Text="{Binding SelectedQuestion.Answer4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel> 

            <StackPanel Orientation="Horizontal"
                        Margin="0,20,0,0">

                <Button Content="Add Question"
                        Width="120"
                        Height="35"
                        Margin="35"
                        Command="{Binding AddQuestionCommand}"/>

                <Button Content="Delete Question"
                        Width="120"
                        Height="35"/>

            </StackPanel>

        </StackPanel>


    </Grid>
</UserControl>
        